# Copiar este archivo a .env y poner los valores reales:
#   cp .env.example .env
# Dentro de Docker el host es el nombre del contenedor de SQL Server (sqlserver);
# corriendo la app fuera de Docker (mvn spring-boot:run) se usa localhost.
URL_SQLSERVER=jdbc:sqlserver://sqlserver:1433;databaseName=curso;encrypt=true;trustServerCertificate=true
USER_NAME=sa
PASSWORD=<contraseña_de_sa>
